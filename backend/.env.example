OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
USE_MOCK_AI=true
ADS_DB_PATH=data/ads_agent.db

SPEECH_ENABLED=true
SPEECH_MODEL_DIR=./data/models/faster-whisper-small
SPEECH_DEVICE=cpu
SPEECH_COMPUTE_TYPE=int8
SPEECH_DEFAULT_LANGUAGE=zh
SPEECH_MAX_FILE_MB=500
SPEECH_AUDIO_DIR=./data/audio
FFMPEG_PATH=../runtime/ffmpeg/bin/ffmpeg.exe
FFPROBE_PATH=../runtime/ffmpeg/bin/ffprobe.exe
